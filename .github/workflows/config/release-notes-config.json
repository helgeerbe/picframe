{
    "categories": [
        {
            "title": "## ⚡ Breaking Changes",
            "labels": [
                "breaking change"
            ]
        },
        {
            "title": "## 🚀 Features",
            "labels": [
                "feat"
            ]
        },
        {
            "title": "## 🐛 Fixes",
            "labels": [
                "fix"
            ]
        },
        {
            "title": "## 📚 Documentation",
            "labels": [
                "docs"
            ]
        },
        {
            "title": "## ♻️ Refactoring",
            "labels": [
                "refactor"
            ]
        },
        {
            "title": "## ⚡ Performance",
            "labels": [
                "perf"
            ]
        },
        {
            "title": "## 🛠 Under the hood",
            "labels": [
                "test",
                "build",
                "ci",
                "chore",
                "revert"
            ]
        }
    ],
    "template": "${{CHANGELOG}}",
    "pr_template": "- ${{TITLE}} (#${{NUMBER}})",
    "empty_template": "- No changes",
    "label_extractor": [
        {
            "pattern": "^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\\(.+\\))?!:.+",
            "target": "$1",
            "on_property": "title"
        }
    ],
    "tag_resolver": {
        "method": "sort"
    }
}